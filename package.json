{
	"name": "dayova-mvp",
	"version": "1.0.6",
	"main": "index.ts",
	"scripts": {
		"preinstall": "only-allow pnpm",
		"start": "run-p expo:start convex:dev",
		"android": "run-p expo:android convex:dev",
		"ios": "run-p expo:ios convex:dev",
		"convex:dev": "convex dev",
		"expo:start": "cross-env APP_VARIANT=development expo start",
		"preexpo:android": "node scripts/prepare-android-autolinking-cache.cjs",
		"expo:android": "cross-env APP_VARIANT=development expo run:android",
		"expo:ios": "cross-env APP_VARIANT=development expo run:ios",
		"lint": "run-s lint:biome lint:plugins",
		"lint:biome": "biome lint .",
		"lint:plugins": "eslint src convex index.ts",
		"lint:fix": "run-s lint:biome:fix lint:plugins:fix format:tailwind",
		"lint:biome:fix": "biome check . --write",
		"lint:plugins:fix": "eslint src convex index.ts --fix",
		"format": "run-s format:biome format:tailwind",
		"format:biome": "biome format . --write",
		"format:tailwind": "biome lint . --only=nursery/useSortedClasses --write",
		"format:check": "run-s format:biome:check format:tailwind:check",
		"format:biome:check": "biome format .",
		"format:tailwind:check": "biome lint . --only=nursery/useSortedClasses",
		"skills:validate": "run-s skills:validate:catalog skills:validate:matt skills:validate:expo",
		"skills:validate:catalog": "node scripts/validate-skills-catalog.mjs",
		"skills:validate:catalog:codex": "node scripts/validate-skills-catalog.mjs --check-codex-config",
		"skills:validate:expo": "node scripts/update-expo-skills.mjs --validate-current",
		"skills:validate:matt": "node scripts/update-matt-pocock-skills.mjs --validate-current",
		"skills:update:expo": "node scripts/update-expo-skills.mjs",
		"skills:update:matt": "node scripts/update-matt-pocock-skills.mjs",
		"test": "run-s test:unit test:ui",
		"test:unit": "run-s test:unit:vitest test:unit:metro-cache test:unit:android-autolinking test:unit:skills",
		"test:unit:android-autolinking": "node --test scripts/android-autolinking-cache.test.cjs",
		"test:unit:vitest": "vitest run",
		"test:unit:expo-config": "vitest run --project expo-config-contract --maxWorkers=1",
		"test:unit:metro-cache": "node --test scripts/metro-cache-concurrency.test.cjs scripts/metro-watcher.test.cjs",
		"test:unit:skills": "node --test scripts/skills-catalog-validation.test.mjs",
		"test:ui": "jest --runInBand",
		"test:smoke:android": "maestro --platform android test -e APP_ID=com.dayova.dev --format junit --output .maestro/artifacts/android/report.xml --test-output-dir .maestro/artifacts/android --debug-output .maestro/artifacts/android/debug .maestro",
		"test:smoke:ios": "maestro --platform ios test -e APP_ID=de.dayova.app-dev --format junit --output .maestro/artifacts/ios/report.xml --test-output-dir .maestro/artifacts/ios --debug-output .maestro/artifacts/ios/debug .maestro",
		"check": "run-s lint typecheck",
		"check:compiler": "pnpm dlx react-compiler-healthcheck@latest",
		"typecheck": "tsc --noEmit",
		"check:unused": "cross-env APP_VARIANT=development knip"
	},
	"dependencies": {
		"@ai-sdk/google-vertex": "^4.0.112",
		"@babel/runtime": "^7.29.2",
		"@clerk/expo": "^4.13.0",
		"@convex-dev/migrations": "^0.3.4",
		"@expo/metro-runtime": "~58.0.14",
		"@expo/ui": "~58.0.20",
		"@gilhrpenner/convex-files-control": "^0.5.3",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@hugeicons/core-free-icons": "^4.1.1",
		"@hugeicons/react-native": "^1.0.13",
		"@rn-primitives/portal": "^1.4.0",
		"@rn-primitives/slot": "^1.4.0",
		"@t3-oss/env-core": "^0.13.11",
		"ai": "^6.0.168",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"convex": "^1.41.0",
		"expo": "~58.0.14",
		"expo-application": "~58.1.2",
		"expo-constants": "~58.0.12",
		"expo-crypto": "~58.0.7",
		"expo-dev-client": "~58.0.14",
		"expo-device": "~58.0.5",
		"expo-document-picker": "~58.0.4",
		"expo-file-system": "~58.0.9",
		"expo-font": "~58.0.8",
		"expo-haptics": "~58.0.7",
		"expo-image-picker": "~58.0.10",
		"expo-linear-gradient": "~58.0.3",
		"expo-linking": "~58.0.13",
		"expo-localization": "~58.0.4",
		"expo-notifications": "~58.1.5",
		"expo-router": "~58.0.23",
		"expo-secure-store": "~58.0.2",
		"expo-splash-screen": "~58.0.10",
		"expo-status-bar": "~58.0.3",
		"expo-system-ui": "~58.0.6",
		"expo-updates": "~58.0.17",
		"nativewind": "^4.2.3",
		"officeparser": "^6.1.0",
		"posthog-react-native": "^4.50.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-css-interop": "^0.2.3",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-purchases": "^10.4.4",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.13.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^3.4.1",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/plugin-transform-react-jsx": "^7.28.6",
		"@biomejs/biome": "^2.4.14",
		"@convex-dev/eslint-plugin": "^2.0.0",
		"@edge-runtime/vm": "^5.0.0",
		"@jest/globals": "30.5.2",
		"@react-native/jest-preset": "0.88.0",
		"@react-native/metro-config": "0.88.0",
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "30.0.0",
		"@types/node": "^24.13.3",
		"@types/react": "~19.3.0",
		"babel-preset-expo": "~58.0.17",
		"convex-test": "^0.0.53",
		"cross-env": "^10.1.0",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jest": "~30.5.2",
		"jest-expo": "~58.0.11",
		"knip": "^6.13.1",
		"npm-run-all2": "^8.0.4",
		"only-allow": "^1.2.2",
		"react-native-svg-transformer": "^1.5.3",
		"sharp": "0.35.5",
		"skills": "1.5.19",
		"smol-toml": "1.7.0",
		"test-renderer": "1.3.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^8.0.14",
		"vitest": "^4.1.7",
		"yaml": "^2.9.0"
	},
	"private": true,
	"expo": {
		"install": {
			"exclude": [
				"jest",
				"@types/jest"
			]
		}
	},
	"engines": {
		"node": ">=24.3 <25"
	},
	"packageManager": "pnpm@11.15.1"
}
