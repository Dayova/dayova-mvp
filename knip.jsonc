{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"plugins/*.js",
		// Invoked manually or by the validation-only EAS benchmark.
		"scripts/benchmark-checks.mjs",
		// Manually invoked topic-search probes and native evidence harness.
		"scripts/evidence/pr884/*.{cjs,mjs,tsx}",
		// Checked by TypeScript, never executed by a runtime test runner.
		"tests/**/*.types.ts",
		// Maintained standalone native QA and release helpers.
		"scripts/native-qa/*.mjs",
		"release/**/scripts/*.cjs",
		// Loaded dynamically by jest.requireActual in UI tests.
		"tests/mocks/*.cjs"
	],
	// Installed outside npm; required for the optional native smoke suite.
	"ignoreBinaries": ["maestro"],
	// prepare.cjs materializes this pinned historical baseline for the harness.
	"ignoreUnresolved": [
		"../../../src/features/learning-plans/pr884-baseline.generated"
	],
	"ignore": [".agents/**"],
	// Required by the EAS/Xcode iOS build path even though app source does not
	// import it directly. Removing it can fail Babel startup with:
	// [BABEL] /Users/expo/workingdir/build/index.ts: Cannot find module '@babel/plugin-transform-react-jsx'
	"ignoreDependencies": [
		"@babel/plugin-transform-react-jsx",
		// Expo config plugins are resolved by name in app.config.cts.
		"expo-font",
		"expo-splash-screen",
		// Invoked through an explicit node_modules/.bin path so the updater can
		// keep its isolated fetch workspace as the CLI working directory.
		"skills"
	],
	"tags": ["-lintignore"]
}
