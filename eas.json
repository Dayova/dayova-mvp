{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "24.18.0",
      "pnpm": "11.15.1"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "environment": "production",
      "ios": {
        "simulator": true
      }
    },
    "day-423-device-qa": {
      "extends": "base",
      "environment": "development",
      "distribution": "internal",
      "channel": "day-423-device-qa",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_CONVEX_URL": "https://spotted-snake-58.eu-west-1.convex.cloud",
        "EXPO_PUBLIC_POSTHOG_API_KEY": "",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "test_day423_qa_no_purchases",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "test_day423_qa_no_purchases"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "ota-staging": {
      "extends": "base",
      "distribution": "internal",
      "channel": "ota-staging",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "ota-staging-testflight": {
      "extends": "production",
      "distribution": "store",
      "channel": "ota-staging"
    },
    "ota-staging-simulator": {
      "extends": "ota-staging-testflight",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      }
    },
    "apk-test": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview"
      },
      "channel": "apk-test"
    },
    "production-apk": {
      "extends": "production",
      "environment": "production",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -x lintVitalAnalyzeRelease"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "closed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "open": {
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6768416097"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
