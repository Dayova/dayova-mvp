# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.pnpm-store/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Local native smoke-test reports, screenshots, and logs
/.maestro/artifacts/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Python tooling caches
__pycache__/
*.py[cod]

# local env files
.env.local
.env
.env.eas-simulator

.idea

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Downloaded store binaries are release evidence, not source artifacts.
/release/google-play/artifacts/*.aab

# PR evidence screenshots belong in GitHub description attachments.
/docs/evidence/**/*.[pP][nN][gG]
/docs/evidence/**/*.[jJ][pP][gG]
/docs/evidence/**/*.[jJ][pP][eE][gG]
/docs/evidence/**/*.[wW][eE][bB][pP]
/docs/pr-screenshots/**/*.[pP][nN][gG]
/docs/pr-screenshots/**/*.[jJ][pP][gG]
/docs/pr-screenshots/**/*.[jJ][pP][eE][gG]
/docs/pr-screenshots/**/*.[wW][eE][bB][pP]
/docs/qa/**/*.[pP][nN][gG]
/docs/qa/**/*.[jJ][pP][gG]
/docs/qa/**/*.[jJ][pP][eE][gG]
/docs/qa/**/*.[wW][eE][bB][pP]
