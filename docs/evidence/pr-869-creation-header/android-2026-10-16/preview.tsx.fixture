import "../src/global.css";
import { useEffect, useState } from "react";
import { View } from "react-native";
import { GestureHandlerRootView } from "react-native-gesture-handler";
import { KeyboardProvider } from "react-native-keyboard-controller";
import { SafeAreaProvider, useSafeAreaInsets } from "react-native-safe-area-context";
import { BottomSheetModalProvider } from "@gorhom/bottom-sheet";
import { vars } from "nativewind";
import { DayovaThemeProvider, useDayovaTheme } from "../src/lib/theme";
import { DARK_THEME_VARIABLES } from "../src/lib/theme-variables";
import { SheetAccessibilityProvider } from "../src/components/ui/sheet-accessibility";
import { SheetSafeAreaProvider } from "../src/components/ui/sheet-safe-area";
import { ThemedStatusBar } from "../src/components/ui/themed-status-bar";
import { LearningPlanCreationProgressHeader } from "../src/features/learning-plans/creation-progress-header";
import { ExamTypePicker } from "../src/components/entry/exam-flow";
import { KeyboardSafeScrollView } from "../src/components/ui/keyboard-safe-scroll-view";
import { Button } from "../src/components/ui/button";
import { Text } from "../src/components/ui/text";

function Screen() {
 const [selected, setSelected] = useState("");
 const { colors, resolvedTheme, isLoaded, setPreference } = useDayovaTheme();
 const insets = useSafeAreaInsets();
 useEffect(()=>{ if(isLoaded) void setPreference("system"); },[isLoaded,setPreference]);
 return <View style={[{flex:1,backgroundColor:colors.background},vars(resolvedTheme==="dark"?DARK_THEME_VARIABLES:{})]}>
 <ThemedStatusBar />
 <View className="bg-background px-8 pb-8" style={{paddingTop:Math.max(insets.top+20,52)}}>
 <LearningPlanCreationProgressHeader currentStep={1} onBack={()=>setSelected("")} onClose={()=>setSelected("")}/>
 </View>
 <View className="px-8 pb-8"><Text className="font-poppins font-semibold text-heading-2 text-text">Welche Art von Prüfung ist es?</Text></View>
 <KeyboardSafeScrollView className="flex-1" bottomOffset={128} contentContainerStyle={{paddingHorizontal:32,paddingTop:0,paddingBottom:168}}>
 <ExamTypePicker selectedValue={selected} onSelect={setSelected}/>
 </KeyboardSafeScrollView>
 <View className="px-6" style={{paddingBottom:Math.max(insets.bottom+10,24)}}>
 <Button disabled={!selected} onPress={()=>{}}><Text>Weiter</Text></Button>
 </View>
 </View>;
}
export default function Preview(){return <GestureHandlerRootView style={{flex:1}}><SafeAreaProvider><KeyboardProvider><DayovaThemeProvider><SheetSafeAreaProvider><BottomSheetModalProvider><SheetAccessibilityProvider><Screen/></SheetAccessibilityProvider></BottomSheetModalProvider></SheetSafeAreaProvider></DayovaThemeProvider></KeyboardProvider></SafeAreaProvider></GestureHandlerRootView>;}
